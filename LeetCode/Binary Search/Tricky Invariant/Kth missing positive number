#include <bits/stdc++.h>
using namespace std;
typedef long long int ll;

class Solution {
public:
    int findKthPositive(vector<int>& arr, int k) {
        int l=0,r=arr.size(), mid = (r+l)/2;
        while(l<r){
            mid = (r+l)/2;
            (arr[mid]-mid-1 < k)? l = mid+1 : r = mid;
        }

        cout<<l + k;
    }
};